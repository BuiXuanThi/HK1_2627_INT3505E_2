{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Room",
  "type": "object",
  "required": [
    "hotel_id",
    "room_number",
    "room_type",
    "capacity",
    "price_per_night"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "hotel_id": {
      "type": "integer",
      "minimum": 1
    },
    "room_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "room_type": {
      "type": "string",
      "enum": [
        "single",
        "double",
        "suite"
      ]
    },
    "capacity": {
      "type": "integer",
      "minimum": 1
    },
    "price_per_night": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "occupied",
        "maintenance"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "additionalProperties": false
}