{
  "info": {
    "_postman_id": "7d87d5e1-9b52-4c85-a7b5-bookstore-week5",
    "name": "BTVN2 - Bookstore Pagination API",
    "description": "Postman collection for testing offset pagination, cursor pagination, genre filtering and multi-key sorting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Offset Pagination",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&offset=0&limit=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "offset",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "3"
            }
          ]
        }
      }
    },
    {
      "name": "02 - Offset Second Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&offset=3&limit=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "offset",
              "value": "3"
            },
            {
              "key": "limit",
              "value": "3"
            }
          ]
        }
      }
    },
    {
      "name": "03 - Filter by Genre",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&genre=Programming",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "genre",
              "value": "Programming"
            }
          ]
        }
      }
    },
    {
      "name": "04 - Multi-key Sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&sort=genre,price",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "sort",
              "value": "genre,price"
            }
          ]
        }
      }
    },
    {
      "name": "05 - Cursor First Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=3&sort=price,id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "cursor"
            },
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "sort",
              "value": "price,id"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.page && body.page.next) {",
              "    pm.collectionVariables.set('cursor', body.page.next);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 - Cursor Next Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=3&sort=price,id&cursor={{cursor}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "cursor"
            },
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "sort",
              "value": "price,id"
            },
            {
              "key": "cursor",
              "value": "{{cursor}}"
            }
          ]
        }
      }
    },
    {
      "name": "07 - Genre + Multi-key Sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&genre=Programming&sort=-price,-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "genre",
              "value": "Programming"
            },
            {
              "key": "sort",
              "value": "-price,-id"
            }
          ]
        }
      }
    },
    {
      "name": "08 - Invalid Strategy",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "abc"
            }
          ]
        }
      }
    },
    {
      "name": "09 - Invalid Sort",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/books?strategy=offset&sort=foo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "books"
          ],
          "query": [
            {
              "key": "strategy",
              "value": "offset"
            },
            {
              "key": "sort",
              "value": "foo"
            }
          ]
        }
      }
    }
  ]
}