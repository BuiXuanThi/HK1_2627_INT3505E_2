{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/book.json",
  "title": "Book",
  "type": "object",
  "required": [
    "title",
    "isbn",
    "price_vnd"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9]{13}$"
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "category_id": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}